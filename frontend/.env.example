# Copy to .env.local for local dev against a deployed backend.
# deploy.sh writes .env.production automatically.
VITE_USE_MOCK=true
VITE_API_URL=https://xxxx.execute-api.ap-southeast-1.amazonaws.com
VITE_USER_POOL_ID=ap-southeast-1_xxxxxxx
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_DOMAIN=nutrimate-123456789012.auth.ap-southeast-1.amazoncognito.com
VITE_SITE_URL=https://dxxxxxxxxxxxx.cloudfront.net
