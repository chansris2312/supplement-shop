# Copy to .env.local for local dev against a deployed backend.
# deploy.sh writes .env.production automatically.
VITE_USE_MOCK=true
VITE_API_URL=https://xxxx.execute-api.us-east-1.amazonaws.com
VITE_USER_POOL_ID=us-east-1_xxxxxxx
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# SiteUrl output: CloudFront (https) or, with USE_CLOUDFRONT=false, http://<bucket>.s3-website-us-east-1.amazonaws.com
VITE_SITE_URL=https://dxxxxxxxxxxxx.cloudfront.net
